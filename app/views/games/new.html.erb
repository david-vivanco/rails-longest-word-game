<div id="container" class = "m-3">
  <h1>New game</h1>
  <%# Get and display the letters from the controller %>
  <% @letters.each do |letter| %>
    <button class = "m-1 p-3 bg-primary text-white"><%= letter %></button>
  <% end %>

  <%# ask user for a word %>
  <form action="/score" method="post" data-turbo="false" class="mt-3 row">
    <label for="word" class="form-label">What is the longest word you can find?</label>
    <div>
      <input type="text" id="word" name="word" placeholder="e.g. cat">
      <input type="submit" value="Play">
    </div>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <% @letters.each do |letter| %>
      <%= hidden_field_tag 'letters[]', letter %>
    <% end %>
  </form>
</div>
